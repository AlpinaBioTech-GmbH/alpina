# =====================================================================
# web-template environment. Copy to .env.local and fill in what you use.
# Every integration is OPTIONAL: the site runs with just Storyblok +
# Supabase + Resend. Social / Voyage / Mux / article-pipeline keys are
# additive, and missing features degrade gracefully.
# =====================================================================

# --- Core ---------------------------------------------------------------
# Canonical site URL (no trailing slash). Used for metadata, OG, links,
# OAuth redirects, and IG slide signing.
NEXT_PUBLIC_SITE_URL=https://localhost:3000
# Optional LAN IP to allow the dev server's assets when testing on a phone.
# DEV_LAN_IP=192.168.1.50

# --- Storyblok (CMS) ----------------------------------------------------
# To create the space + push the catalog, set your Personal Access Token here,
# then run `npm run create-space` (fills in the tokens below) and `npm run seed`.
STORYBLOK_PERSONAL_ACCESS_TOKEN=   # account token: https://app.storyblok.com/#/me/account?tab=token
NEXT_PUBLIC_STORYBLOK_REGION=eu    # eu | us | ap | ca | cn
# Filled in automatically by `npm run create-space`:
STORYBLOK_PREVIEW_TOKEN=        # secret preview token (reads draft + published)
NEXT_PUBLIC_STORYBLOK_TOKEN=    # public delivery token (Visual Editor bridge)
STORYBLOK_MANAGEMENT_TOKEN=     # management token (the PAT, used by the seed)
STORYBLOK_SPACE_ID=             # Storyblok space id
STORYBLOK_DRAFT_SECRET=         # protects /api/draft enter-preview route
STORYBLOK_WEBHOOK_SECRET=       # Storyblok publish webhook -> /api/revalidate (falls back to DRAFT_SECRET)

# --- Supabase (database + admin auth) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (preferred)
SUPABASE_SECRET_KEY=                    # sb_secret_... (server only, preferred)
# Legacy fallbacks (only if not using the new keys):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Admin allowlist ----------------------------------------------------
# Bootstrap allowlist for the first sign-in (comma-separated). After that,
# manage admins in /admin/admins (admin_users table).
ADMIN_EMAILS=you@example.com

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=
CONTACT_NOTIFY_TO=you@example.com        # contact-form notification recipient
CONTACT_FROM=Acme <noreply@example.com>  # verified Resend sender

# --- AI assistant (Anthropic) -------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=                    # optional gateway
# Article pipeline tuning (optional):
# WRITER_MODEL=claude-sonnet-4-6
# EDITOR_MODEL=claude-sonnet-4-6
# SOCIAL_MODEL=claude-sonnet-4-6
# ARTICLE_PUBLISH_FLOOR=70
# MAX_ARTICLE_REVISIONS=2

# --- RAG embeddings (Voyage) --------------------------------------------
# Without this, the assistant answers without retrieved context.
VOYAGE_API_KEY=

# --- Cron / automation --------------------------------------------------
CRON_SECRET=                    # bearer token for /api/cron/post-social
SOCIAL_OPERATOR_EMAIL=you@example.com  # failure-alert recipient
IG_SLIDE_SIGNING_SECRET=        # MUST match between Vercel and GitHub Actions

# --- Social: X / Twitter (company account) ------------------------------
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://localhost:3000/api/auth/twitter/callback
# Personal cross-post account (reuses the same X app, second callback URL):
# TWITTER_MEMBER_CLIENT_ID=
# TWITTER_MEMBER_CLIENT_SECRET=
# TWITTER_MEMBER_REDIRECT_URI=https://localhost:3000/api/auth/twitter-member/callback

# --- Social: LinkedIn (company page; Community Management API app) -------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://localhost:3000/api/auth/linkedin/callback
# LINKEDIN_VERSION=202506
# LINKEDIN_SCOPES=rw_organization_admin w_organization_social r_organization_social
# Personal profile cross-post (SEPARATE LinkedIn app: OpenID + Share):
# LINKEDIN_MEMBER_CLIENT_ID=
# LINKEDIN_MEMBER_CLIENT_SECRET=
# LINKEDIN_MEMBER_REDIRECT_URI=https://localhost:3000/api/auth/linkedin-member/callback
# LINKEDIN_MEMBER_SCOPES=openid profile w_member_social

# --- Social: Instagram (Meta Graph, business account) -------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:3000/api/auth/instagram/callback

# --- Images -------------------------------------------------------------
PEXELS_API_KEY=                 # optional stock cover images for articles

# --- Article pipeline (GitHub Actions manual dispatch) ------------------
# GITHUB_REPO=owner/repo         # enables the admin "Run pipeline now" button
